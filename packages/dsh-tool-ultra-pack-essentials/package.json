{
  "name": "@lvy-jsd/dsh-tool-ultra-pack-essentials",
  "version": "0.5.0",
  "description": "Tool Ultra essentials pack: time zones, date math, a calculator with units, weather, place search and Wikipedia. No API keys.",
  "license": "Apache-2.0",
  "author": "lvy-jsd",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/.tsbuildinfo",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b .",
    "prepack": "tsc -b ."
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-tool-ultra",
    "tools",
    "weather",
    "wikipedia",
    "calculator",
    "timezone"
  ],
  "dependencies": {
    "mathjs": "^15.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "toolCatalog": {
      "tools": {
        "time_now": { "group": "time", "category": "system" },
        "time_convert": { "group": "time", "category": "system" },
        "date_diff": { "group": "time", "category": "system" },
        "math_eval": { "group": "math", "category": "system" },
        "weather_forecast": { "group": "weather", "category": "maps" },
        "geo_search": { "group": "places", "category": "maps" },
        "wiki_search": { "group": "wikipedia", "category": "search" },
        "wiki_summary": { "group": "wikipedia", "category": "search" }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lvy-jsd/dsh-tool-ultra.git",
    "directory": "packages/dsh-tool-ultra-pack-essentials"
  }
}
