{
  "name": "@lvy-jsd/create-dsh-tool-ultra-plugin",
  "version": "0.5.0",
  "description": "Scaffold a Tool Ultra extension: classifier, visibility filter, hook listener or package.json declaration.",
  "license": "Apache-2.0",
  "author": "lvy-jsd",
  "type": "module",
  "main": "lib/cli.js",
  "types": "lib/cli.d.ts",
  "bin": {
    "create-dsh-tool-ultra-plugin": "./lib/index.js"
  },
  "exports": {
    ".": {
      "types": "./lib/cli.d.ts",
      "default": "./lib/cli.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/.tsbuildinfo",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b .",
    "prepack": "tsc -b ."
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-tool-ultra",
    "scaffold",
    "create"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lvy-jsd/dsh-tool-ultra.git",
    "directory": "packages/create-dsh-tool-ultra-plugin"
  }
}
