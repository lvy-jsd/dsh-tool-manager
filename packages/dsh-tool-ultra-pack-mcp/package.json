{
  "name": "@lvy-jsd/dsh-tool-ultra-pack-mcp",
  "version": "0.5.0",
  "description": "Tool Ultra MCP preset pack: memory, sequential thinking, Context7, Playwright, filesystem, GitHub, SearXNG, Brave, Tavily, Firecrawl, Notion and AMap, started through dsh-mcp-client. Keyless presets start by default.",
  "license": "Apache-2.0",
  "author": "lvy-jsd",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/.tsbuildinfo",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b .",
    "prepack": "tsc -b ."
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-tool-ultra",
    "mcp",
    "mcp-server",
    "presets"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.0-0 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "toolCatalog": {
      "tools": {
        "mcp_presets": {
          "group": "mcp-presets",
          "category": "connectors",
          "summary": "Which MCP presets run and which wait for a key."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lvy-jsd/dsh-tool-ultra.git",
    "directory": "packages/dsh-tool-ultra-pack-mcp"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  }
}
