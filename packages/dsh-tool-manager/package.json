{
  "name": "@lvy-jsd/dsh-tool-manager",
  "version": "0.5.0",
  "description": "Renamed to @lvy-jsd/dsh-tool-ultra-core. This package only re-exports it, so existing DSH profiles keep their loader entry and config.",
  "license": "Apache-2.0",
  "author": "lvy-jsd",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lvy-jsd/dsh-tool-ultra-core": "0.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lvy-jsd/dsh-tool-ultra.git",
    "directory": "packages/dsh-tool-manager"
  }
}
