{
  "name": "@lvy-jsd/dsh-tool-ultra-pack-media",
  "version": "0.5.0",
  "description": "Tool Ultra media pack: images, music and video made from code. SVG drawings and Vega-Lite charts to PNG/JPEG/WebP, short scores to MIDI and WAV, SVG scenes to MP4 (with the host's ffmpeg). No model API, no API keys.",
  "license": "Apache-2.0",
  "author": "lvy-jsd",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/.tsbuildinfo",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b .",
    "prepack": "tsc -b ."
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-tool-ultra",
    "tools",
    "svg",
    "chart",
    "vega-lite",
    "image",
    "music",
    "midi",
    "video",
    "ffmpeg"
  ],
  "dependencies": {
    "sharp": "^0.35.5",
    "vega": "^6.4.0",
    "vega-interpreter": "^2.3.2",
    "vega-lite": "^6.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "toolCatalog": {
      "tools": {
        "svg_render": {
          "group": "image",
          "category": "media",
          "risk": "low"
        },
        "chart_render": {
          "group": "image",
          "category": "media",
          "risk": "low"
        },
        "music_render": {
          "group": "audio",
          "category": "media",
          "risk": "low"
        },
        "video_render": {
          "group": "video",
          "category": "media",
          "risk": "low"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lvy-jsd/dsh-tool-ultra.git",
    "directory": "packages/dsh-tool-ultra-pack-media"
  }
}
