{
  "name": "@lvy-jsd/dsh-tool-ultra-pack-audio-creative",
  "version": "0.5.0",
  "description": "Tool Ultra audio creative pack: Edge-TTS speech synthesis and ffmpeg audio editing and mixing.",
  "license": "Apache-2.0",
  "author": "lvy-jsd",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/.tsbuildinfo",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b .",
    "prepack": "tsc -b ."
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-tool-ultra",
    "tools",
    "audio",
    "tts",
    "edge-tts",
    "ffmpeg",
    "mix"
  ],
  "dependencies": {
    "msedge-tts": "^2.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "toolCatalog": {
      "tools": {
        "audio_synthesize": {
          "group": "audio",
          "category": "media"
        },
        "audio_cut": {
          "group": "audio",
          "category": "media"
        },
        "audio_mix": {
          "group": "audio",
          "category": "media"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lvy-jsd/dsh-tool-ultra.git",
    "directory": "packages/dsh-tool-ultra-pack-audio-creative"
  }
}
