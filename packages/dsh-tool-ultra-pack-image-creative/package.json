{
  "name": "@lvy-jsd/dsh-tool-ultra-pack-image-creative",
  "version": "0.5.0",
  "description": "Tool Ultra image creation and editing pack: AI image generation and high-performance pixel operations via sharp.",
  "license": "Apache-2.0",
  "author": "lvy-jsd",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/.tsbuildinfo",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b .",
    "prepack": "tsc -b ."
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-tool-ultra",
    "tools",
    "image",
    "sharp",
    "creative",
    "generation",
    "edit"
  ],
  "dependencies": {
    "sharp": "^0.33.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "toolCatalog": {
      "tools": {
        "image_generate": {
          "group": "image",
          "category": "media"
        },
        "image_edit": {
          "group": "image",
          "category": "media"
        },
        "image_metadata": {
          "group": "image",
          "category": "media"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lvy-jsd/dsh-tool-ultra.git",
    "directory": "packages/dsh-tool-ultra-pack-image-creative"
  }
}
